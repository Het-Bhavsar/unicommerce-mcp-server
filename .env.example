# --- Relay auth (required in http mode) ---
# Shared team access key: used as `Authorization: Bearer <key>` and on the OAuth consent page.
TEAM_API_KEY=change-me-long-random-string
# Optional: JWT signing secret for OAuth tokens (defaults to an HMAC derived from TEAM_API_KEY).
OAUTH_SIGNING_SECRET=
# Optional: public URL of this relay (defaults to https://$RAILWAY_PUBLIC_DOMAIN, then the request Host).
PUBLIC_BASE_URL=

# --- Server ---
# Railway sets PORT automatically; when PORT is set, MCP_TRANSPORT defaults to http.
PORT=3000
MCP_TRANSPORT=http

# --- Uniware (server-side login) ---
# Tenant name (-> https://<tenant>.unicommerce.com), a host, or a full URL.
UNICOMMERCE_TENANT=your-tenant
UNICOMMERCE_USERNAME=api-user@example.com
UNICOMMERCE_PASSWORD=your-password
# Optional (defaults: my-trusted-client / 01)
UNICOMMERCE_CLIENT_ID=
UNICOMMERCE_FACILITY=
# Optional: overrides the base URL derived from UNICOMMERCE_TENANT
UNICOMMERCE_BASE_URL=
